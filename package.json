{
  "name": "veil-bookmark",
  "version": "1.13.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "i18n": "node scripts/build-i18n.mjs",
    "build": "node scripts/check-version.mjs && node scripts/check-i18n.mjs && tsc --noEmit && vite build && node scripts/package.mjs",
    "build:web": "node scripts/check-version.mjs && node scripts/check-i18n.mjs && tsc --noEmit && vite build -c vite.web.config.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.43",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.56.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
