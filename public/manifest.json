{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.8.1",
  "minimum_chrome_version": "120",
  "description": "__MSG_appDesc__",
  "permissions": [
    "storage",
    "alarms",
    "idle",
    "activeTab",
    "identity",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "index.html?popup",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "incognito": "spanning",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "default_locale": "zh_TW",
  "key": "",
  "homepage_url": "https://ryanxuwei.github.io/veil-bookmark/",
  "oauth2": {
    "client_id": "421756368742-le4vgul446d0nbtlbl6kjjhrsm0qr1o9.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  }
}
