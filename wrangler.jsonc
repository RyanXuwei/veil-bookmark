{
  // Cloudflare: the mobile web app is a static site served from web-dist/ at
  // its own address (veil-bookmark.bitingbox.win, attached in the dashboard
  // under the Worker's Domains & Routes). Build command:
  // npm ci && npm run build:web    Deploy command: npx wrangler deploy
  "name": "veil-bookmark",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./web-dist"
  }
}
